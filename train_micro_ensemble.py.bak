"""
Train Micro Ensemble v15.2

A comprehensive script for training an ensemble of micro-prediction models
for financial time series forecasting. Supports multiple model architectures
including LSTM, CNN, and Transformer models with advanced training features.

Features:
- Multiple model architectures (LSTM, CNN, Transformer, Hybrid)
- Advanced ensemble methods (Averaging, Stacking, Blending)
- Hyperparameter optimization with Optuna
- Cross-validation
- Early stopping and model checkpointing
- Mixed precision training
- TensorBoard logging
- Model export to ONNX/TensorFlow Lite
- Comprehensive metrics and evaluation
"""

import os
import sys
import time
import json
import logging
import argparse
import warnings
from pathlib import Path
from typing import Dict, List, Tuple, Optional, Union, Any, Callable
from dataclasses import dataclass, field
from enum import Enum, auto

import numpy as np
import pandas as pd
import tensorflow as tf
from tensorflow.keras import layers, models, optimizers, losses, metrics, callbacks
import tensorflow_addons as tfa
import sklearn
from sklearn.model_selection import train_test_split, TimeSeriesSplit
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score
import optuna
from optuna.integration import TFKerasPruningCallback
import matplotlib.pyplot as plt
import seaborn as sns
import joblib
import onnx
import tf2onnx
import onnxruntime as ort
from tqdm.keras import TqdmCallback

# Suppress warnings
warnings.filterwarnings('ignore')
os.environ['TF_CPP_MIN_LOG_LEVEL'] = '2'  # Suppress TensorFlow logging
tf.get_logger().setLevel('ERROR')

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
    handlers=[
        logging.StreamHandler(),
        logging.FileHandler('train_ensemble.log')
    ]
)
logger = logging.getLogger('train_ensemble')

# Type aliases
Array = np.ndarray
Tensor = tf.Tensor
Model = tf.keras.Model
DataLoader = tf.keras.utils.Sequence

class ModelType(Enum):
    """Supported model types."""
    LSTM = auto()
    CNN = auto()
    TRANSFORMER = auto()
    CNN_LSTM = auto()
    CNN_TRANSFORMER = auto()

class EnsembleMethod(Enum):
    """Ensemble combination methods."""
    AVERAGE = auto()
    VOTING = auto()
    STACKING = auto()
    BAGGING = auto()
    BOOSTING = auto()

@dataclass
class ModelConfig:
    """Configuration for a single model in the ensemble."""
    model_type: ModelType
    params: Dict[str, Any]
    input_shape: Tuple[int, ...]
    num_classes: int
    name: Optional[str] = None
    trainable: bool = True
    weight: float = 1.0

@dataclass
class TrainingConfig:
    """Training configuration."""
    batch_size: int = 64
    epochs: int = 100
    learning_rate: float = 1e-3
    patience: int = 10
    min_delta: float = 1e-4
    validation_split: float = 0.2
    test_size: float = 0.1
    use_class_weights: bool = True
    class_weights: Optional[Dict[int, float]] = None
    metrics: List[str] = field(default_factory=lambda: ['accuracy'])
    loss: str = 'categorical_crossentropy'
    optimizer: str = 'adam'
    mixed_precision: bool = True
    clip_norm: Optional[float] = 1.0
    early_stopping: bool = True
    reduce_lr: bool = True
    tensorboard: bool = True
    checkpoint: bool = True
    verbose: int = 1

@dataclass
class DataConfig:
    """Data configuration."""
    sequence_length: int = 60
    num_features: int = 10
    num_classes: int = 3
    train_val_split: float = 0.8
    test_split: float = 0.1
    shuffle: bool = True
    random_state: int = 42
    normalize: bool = True
    scale_range: Tuple[float, float] = (0, 1)

class MicroEnsemble:
    """
    Micro Ensemble for time series prediction.
    
    This class implements an ensemble of deep learning models for micro-prediction
    of financial time series. It supports multiple model architectures and
    ensemble methods.
    """
    
    def __init__(
        self,
        model_configs: List[ModelConfig],
        ensemble_method: EnsembleMethod = EnsembleMethod.AVERAGE,
        output_dir: Union[str, Path] = 'models/micro_ensemble',
        name: str = 'micro_ensemble'
    ):
        """
        Initialize the MicroEnsemble.
        
        Args:
            model_configs: List of model configurations
            ensemble_method: Method for combining model predictions
            output_dir: Directory to save model files
            name: Name of the ensemble
        """
        self.model_configs = model_configs
        self.ensemble_method = ensemble_method
        self.output_dir = Path(output_dir)
        self.name = name
        self.models = []
        self.meta_model = None
        self.scaler = None
        self.class_weights = None
        self.history = None
        self.metrics = {}
        
        # Create output directory
        self.output_dir.mkdir(parents=True, exist_ok=True)
        
        # Set mixed precision if available
        self.policy = tf.keras.mixed_precision.Policy('mixed_float16')
        tf.keras.mixed_precision.set_global_policy(self.policy)
        
        logger.info(f"Initialized MicroEnsemble with {len(model_configs)} models")
    
    def build_models(self) -> None:
        """Build all models in the ensemble."""
        self.models = []
        for config in self.model_configs:
            model = self._build_single_model(config)
            self.models.append({
                'config': config,
                'model': model,
                'history': None,
                'metrics': {}
            })
            logger.info(f"Built {config.model_type.name} model: {config.name or ''}")
    
    def _build_single_model(self, config: ModelConfig) -> Model:
        """Build a single model based on configuration."""
        if config.model_type == ModelType.LSTM:
            return self._build_lstm_model(config)
        elif config.model_type == ModelType.CNN:
            return self._build_cnn_model(config)
        elif config.model_type == ModelType.TRANSFORMER:
            return self._build_transformer_model(config)
        elif config.model_type == ModelType.CNN_LSTM:
            return self._build_cnn_lstm_model(config)
        elif config.model_type == ModelType.CNN_TRANSFORMER:
            return self._build_cnn_transformer_model(config)
        else:
            raise ValueError(f"Unsupported model type: {config.model_type}")
    
    def _build_lstm_model(self, config: ModelConfig) -> Model:
        """Build an LSTM model."""
        params = config.params.get('lstm', {})
        inputs = layers.Input(shape=config.input_shape)
        
        # LSTM layers
        x = layers.LSTM(
            units=params.get('units', 64),
            return_sequences=params.get('return_sequences', True),
            dropout=params.get('dropout', 0.2),
            recurrent_dropout=params.get('recurrent_dropout', 0.2)
        )(inputs)
        
        if params.get('num_layers', 1) > 1:
            for _ in range(params['num_layers'] - 1):
                x = layers.LSTM(
                    units=params.get('units', 32),
                    return_sequences=False,
                    dropout=params.get('dropout', 0.2),
                    recurrent_dropout=params.get('recurrent_dropout', 0.2)
                )(x)
        
        # Dense layers
        for units in params.get('dense_units', [64, 32]):
            x = layers.Dense(units, activation='relu')(x)
            x = layers.Dropout(params.get('dense_dropout', 0.3))(x)
        
        # Output layer
        outputs = layers.Dense(config.num_classes, activation='softmax')(x)
        
        model = models.Model(inputs=inputs, outputs=outputs, name=config.name or 'lstm_model')
        return model
    
    def _build_cnn_model(self, config: ModelConfig) -> Model:
        """Build a CNN model."""
        params = config.params.get('cnn', {})
        inputs = layers.Input(shape=config.input_shape)
        
        # CNN layers
        x = layers.Conv1D(
            filters=params.get('filters', [64, 128]),
            kernel_size=params.get('kernel_size', 3),
            activation='relu',
            padding='same'
        )(inputs)
        x = layers.MaxPooling1D(pool_size=2)(x)
        x = layers.BatchNormalization()(x)
        
        # Additional CNN blocks
        for filters in params.get('filters', [128, 64])[1:]:
            x = layers.Conv1D(
                filters=filters,
                kernel_size=params.get('kernel_size', 3),
                activation='relu',
                padding='same'
            )(x)
            x = layers.MaxPooling1D(pool_size=2)(x)
            x = layers.BatchNormalization()(x)
        
        # Flatten and dense layers
        x = layers.Flatten()(x)
        for units in params.get('dense_units', [128, 64]):
            x = layers.Dense(units, activation='relu')(x)
            x = layers.Dropout(params.get('dropout', 0.3))(x)
        
        # Output layer
        outputs = layers.Dense(config.num_classes, activation='softmax')(x)
        
        model = models.Model(inputs=inputs, outputs=outputs, name=config.name or 'cnn_model')
        return model
    
    def _build_transformer_model(self, config: ModelConfig) -> Model:
        """Build a Transformer model."""
        params = config.params.get('transformer', {})
        num_heads = params.get('num_heads', 4)
        ff_dim = params.get('ff_dim', 64)
        num_transformer_blocks = params.get('num_blocks', 2)
        mlp_units = params.get('mlp_units', [128, 64])
        dropout = params.get('dropout', 0.1)
        mlp_dropout = params.get('mlp_dropout', 0.3)
        
        inputs = layers.Input(shape=config.input_shape)
        
        # Positional encoding
        x = inputs
        if params.get('use_positional_encoding', True):
            x = self._positional_encoding(x)
        
        # Transformer blocks
        for _ in range(num_transformer_blocks):
            # Multi-head self-attention
            attention_output = layers.MultiHeadAttention(
                num_heads=num_heads,
                key_dim=config.input_shape[-1] // num_heads,
                dropout=dropout
            )(x, x)
            
            # Skip connection 1
            x = layers.Add()([attention_output, x])
            x = layers.LayerNormalization(epsilon=1e-6)(x)
            
            # Feed-forward network
            ffn = layers.Dense(ff_dim, activation='relu')(x)
            ffn = layers.Dropout(dropout)(ffn)
            ffn = layers.Dense(config.input_shape[-1])(ffn)
            
            # Skip connection 2
            x = layers.Add()([ffn, x])
            x = layers.LayerNormalization(epsilon=1e-6)(x)
        
        # Global average pooling and MLP
        x = layers.GlobalAveragePooling1D()(x)
        for dim in mlp_units:
            x = layers.Dense(dim, activation='relu')(x)
            x = layers.Dropout(mlp_dropout)(x)
        
        # Output layer
        outputs = layers.Dense(config.num_classes, activation='softmax')(x)
        
        model = models.Model(inputs=inputs, outputs=outputs, name=config.name or 'transformer_model')
        return model
    
    def _build_cnn_lstm_model(self, config: ModelConfig) -> Model:
        """Build a CNN-LSTM hybrid model."""
        params = config.params.get('cnn_lstm', {})
        inputs = layers.Input(shape=config.input_shape)
        
        # CNN part
        x = layers.Conv1D(
            filters=params.get('cnn_filters', [64, 128]),
            kernel_size=params.get('kernel_size', 3),
            activation='relu',
            padding='same'
        )(inputs)
        x = layers.MaxPooling1D(pool_size=2)(x)
        x = layers.BatchNormalization()(x)
        
        # LSTM part
        x = layers.LSTM(
            units=params.get('lstm_units', 128),
            return_sequences=False,
            dropout=params.get('dropout', 0.2),
            recurrent_dropout=params.get('recurrent_dropout', 0.2)
        )(x)
        
        # Dense layers
        for units in params.get('dense_units', [64, 32]):
            x = layers.Dense(units, activation='relu')(x)
            x = layers.Dropout(params.get('dense_dropout', 0.3))(x)
        
        # Output layer
        outputs = layers.Dense(config.num_classes, activation='softmax')(x)
        
        model = models.Model(inputs=inputs, outputs=outputs, name=config.name or 'cnn_lstm_model')
        return model
    
    def _build_cnn_transformer_model(self, config: ModelConfig) -> Model:
        """Build a CNN-Transformer hybrid model."""
        # Implementation similar to above but combining CNN and Transformer
        pass
    
    def _positional_encoding(self, x: Tensor) -> Tensor:
        """Add positional encoding to the input tensor."""
        position = tf.range(x.shape[1], dtype=tf.float32)[tf.newaxis, :, tf.newaxis]
        div_term = tf.exp(tf.range(0, x.shape[2], 2, dtype=tf.float32) * 
                         -(np.log(10000.0) / x.shape[2]))
        
        pos_encoding = tf.zeros((1, x.shape[1], x.shape[2]))
        pos_encoding = tf.tensor_scatter_nd_update(
            pos_encoding,
            [[0, i, j] for i in range(x.shape[1]) for j in range(0, x.shape[2], 2)],
            [tf.sin(position * div_term[j // 2]) for i in range(x.shape[1]) for j in range(0, x.shape[2], 2)]
        )
        
        if x.shape[2] % 2 == 0:
            pos_encoding = tf.tensor_scatter_nd_update(
                pos_encoding,
                [[0, i, j] for i in range(x.shape[1]) for j in range(1, x.shape[2], 2)],
                [tf.cos(position * div_term[j // 2]) for i in range(x.shape[1]) for j in range(1, x.shape[2], 2)]
            )
        
        return x + pos_encoding
    
    def compile_models(self, training_config: TrainingConfig) -> None:
        """Compile all models in the ensemble."""
        for model_info in self.models:
            model = model_info['model']
            optimizer = self._get_optimizer(training_config)
            model.compile(
                optimizer=optimizer,
                loss=training_config.loss,
                metrics=training_config.metrics
            )
            logger.info(f"Compiled model: {model.name}")
    
    def _get_optimizer(self, config: TrainingConfig) -> tf.keras.optimizers.Optimizer:
        """Get optimizer based on configuration."""
        if config.optimizer.lower() == 'adam':
            return optimizers.Adam(
                learning_rate=config.learning_rate,
                clipnorm=config.clip_norm
            )
        elif config.optimizer.lower() == 'rmsprop':
            return optimizers.RMSprop(
                learning_rate=config.learning_rate,
                clipnorm=config.clip_norm
            )
        elif config.optimizer.lower() == 'sgd':
            return optimizers.SGD(
                learning_rate=config.learning_rate,
                momentum=0.9,
                nesterov=True,
                clipnorm=config.clip_norm
            )
        else:
            raise ValueError(f"Unsupported optimizer: {config.optimizer}")
    
    def train(
        self,
        X_train: Array,
        y_train: Array,
        X_val: Optional[Array] = None,
        y_val: Optional[Array] = None,
        training_config: Optional[TrainingConfig] = None
    ) -> Dict[str, Any]:
        """
        Train the ensemble of models.
        
        Args:
            X_train: Training features
            y_train: Training labels
            X_val: Validation features (optional)
            y_val: Validation labels (optional)
            training_config: Training configuration
            
        Returns:
            Dictionary with training history and metrics
        """
        if training_config is None:
            training_config = TrainingConfig()
        
        # Split data if validation set not provided
        if X_val is None or y_val is None:
            X_train, X_val, y_train, y_val = train_test_split(
                X_train, y_train,
                test_size=training_config.validation_split,
                random_state=training_config.random_state,
                shuffle=training_config.shuffle
            )
        
        # Calculate class weights if needed
        if training_config.use_class_weights and training_config.class_weights is None:
            class_weights = self._calculate_class_weights(y_train)
            training_config.class_weights = class_weights
        
        self.class_weights = training_config.class_weights
        
        # Train each model in the ensemble
        for i, model_info in enumerate(self.models):
            logger.info(f"Training model {i+1}/{len(self.models)}: {model_info['model'].name}")
            
            # Create callbacks
            callbacks_list = self._create_callbacks(
                model_name=model_info['model'].name,
                training_config=training_config
            )
            
            # Train the model
            history = model_info['model'].fit(
                X_train, y_train,
                batch_size=training_config.batch_size,
                epochs=training_config.epochs,
                validation_data=(X_val, y_val),
                class_weight=training_config.class_weights,
                callbacks=callbacks_list,
                verbose=training_config.verbose
            )
            
            # Save training history
            model_info['history'] = history.history
            model_info['metrics'] = self._evaluate_model(
                model_info['model'], X_val, y_val
            )
            
            # Save the model
            if training_config.checkpoint:
                self._save_model(model_info, i)
        
        # Train meta-model if using stacking
        if self.ensemble_method == EnsembleMethod.STACKING:
            self._train_stacking_model(X_train, y_train, X_val, y_val, training_config)
        
        # Evaluate ensemble
        ensemble_metrics = self.evaluate(X_val, y_val)
        self.metrics = ensemble_metrics
        
        return {
            'history': [m['history'] for m in self.models],
            'metrics': self.metrics
        }
    
    def _create_callbacks(
        self,
        model_name: str,
        training_config: TrainingConfig
    ) -> List[callbacks.Callback]:
        """Create training callbacks."""
        callbacks_list = []
        
        # Early stopping
        if training_config.early_stopping:
            early_stopping = callbacks.EarlyStopping(
                monitor='val_loss',
                patience=training_config.patience,
                min_delta=training_config.min_delta,
                restore_best_weights=True,
                verbose=training_config.verbose
            )
            callbacks_list.append(early_stopping)
        
        # Reduce learning rate on plateau
        if training_config.reduce_lr:
            reduce_lr = callbacks.ReduceLROnPlateau(
                monitor='val_loss',
                factor=0.5,
                patience=training_config.patience // 2,
                min_lr=1e-6,
                verbose=training_config.verbose
            )
            callbacks_list.append(reduce_lr)
        
        # Model checkpoint
        if training_config.checkpoint:
            model_dir = self.output_dir / 'checkpoints' / model_name
            model_dir.mkdir(parents=True, exist_ok=True)
            
            checkpoint = callbacks.ModelCheckpoint(
                filepath=str(model_dir / 'best_model.h5'),
                monitor='val_loss',
                save_best_only=True,
                save_weights_only=False,
                mode='min',
                verbose=training_config.verbose
            )
            callbacks_list.append(checkpoint)
        
        # TensorBoard
        if training_config.tensorboard:
            log_dir = self.output_dir / 'logs' / model_name
            log_dir.mkdir(parents=True, exist_ok=True)
            
            tensorboard = callbacks.TensorBoard(
                log_dir=log_dir,
                histogram_freq=1,
                update_freq='epoch'
            )
            callbacks_list.append(tensorboard)
        
        # Add progress bar
        if training_config.verbose == 1:
            callbacks_list.append(TqdmCallback(verbose=1))
        
        return callbacks_list
    
    def _calculate_class_weights(self, y: Array) -> Dict[int, float]:
        """Calculate class weights for imbalanced datasets."""
        from sklearn.utils.class_weight import compute_class_weight
        y_integers = np.argmax(y, axis=1) if len(y.shape) > 1 and y.shape[1] > 1 else y
        classes = np.unique(y_integers)
        weights = compute_class_weight('balanced', classes=classes, y=y_integers)
        return dict(zip(classes, weights))
    
    def _evaluate_model(self, model: Model, X: Array, y: Array) -> Dict[str, float]:
        """Evaluate a single model."""
        y_pred = model.predict(X, verbose=0)
        y_true = np.argmax(y, axis=1) if len(y.shape) > 1 and y.shape[1] > 1 else y
        y_pred_classes = np.argmax(y_pred, axis=1) if len(y_pred.shape) > 1 and y_pred.shape[1] > 1 else y_pred
        
        metrics = {
            'accuracy': accuracy_score(y_true, y_pred_classes),
            'precision': precision_score(y_true, y_pred_classes, average='weighted', zero_division=0),
            'recall': recall_score(y_true, y_pred_classes, average='weighted', zero_division=0),
            'f1': f1_score(y_true, y_pred_classes, average='weighted', zero_division=0)
        }
        
        return metrics
    
    def _save_model(self, model_info: Dict[str, Any], index: int) -> None:
        """Save a single model."""
        model_dir = self.output_dir / 'models' / f"model_{index}_{model_info['model'].name}"
        model_dir.mkdir(parents=True, exist_ok=True)
        
        # Save model
        model_path = model_dir / 'model.h5'
        model_info['model'].save(model_path)
        
        # Save configuration
        config = {
            'model_type': model_info['config'].model_type.name,
            'input_shape': model_info['config'].input_shape,
            'num_classes': model_info['config'].num_classes,
            'params': model_info['config'].params,
            'metrics': model_info.get('metrics', {})
        }
        
        with open(model_dir / 'config.json', 'w') as f:
            json.dump(config, f, indent=2)
        
        logger.info(f"Saved model to {model_path}")
    
    def _train_stacking_model(
        self,
        X_train: Array,
        y_train: Array,
        X_val: Array,
        y_val: Array,
        training_config: TrainingConfig
    ) -> None:
        """Train a meta-model for stacking ensemble."""
        # Generate predictions from base models
        base_preds_train = self._get_base_predictions(X_train)
        base_preds_val = self._get_base_predictions(X_val)
        
        # Train meta-model (simple DNN)
        meta_model = self._build_meta_model(
            num_models=len(self.models),
            num_classes=self.models[0]['config'].num_classes
        )
        
        meta_model.compile(
            optimizer=training_config.optimizer,
            loss=training_config.loss,
            metrics=training_config.metrics
        )
        
        meta_model.fit(
            base_preds_train, y_train,
            validation_data=(base_preds_val, y_val),
            epochs=training_config.epochs,
            batch_size=training_config.batch_size,
            callbacks=self._create_callbacks('meta_model', training_config),
            verbose=training_config.verbose
        )
        
        self.meta_model = meta_model
        logger.info("Trained stacking meta-model")
    
    def _get_base_predictions(self, X: Array) -> Array:
        """Get predictions from all base models."""
        return np.array([model['model'].predict(X, verbose=0) for model in self.models])
    
    def _build_meta_model(
        self,
        num_models: int,
        num_classes: int,
        hidden_units: List[int] = [64, 32]
    ) -> Model:
        """Build a meta-model for stacking."""
        inputs = layers.Input(shape=(num_models, num_classes))
        x = layers.Flatten()(inputs)
        
        for units in hidden_units:
            x = layers.Dense(units, activation='relu')(x)
            x = layers.Dropout(0.3)(x)
        
        outputs = layers.Dense(num_classes, activation='softmax')(x)
        return models.Model(inputs=inputs, outputs=outputs, name='meta_model')
    
    def predict(self, X: Array) -> Array:
        """Make predictions using the ensemble."""
        if not self.models:
            raise ValueError("No models in the ensemble. Train the ensemble first.")
        
        # Get predictions from all models
        predictions = []
        for model_info in self.models:
            pred = model_info['model'].predict(X, verbose=0)
            predictions.append(pred)
        
        # Combine predictions based on ensemble method
        if self.ensemble_method == EnsembleMethod.AVERAGE:
            return np.mean(predictions, axis=0)
        elif self.ensemble_method == EnsembleMethod.VOTING:
            # For classification, take the majority vote
            pred_classes = np.argmax(predictions, axis=-1)
            return np.apply_along_axis(
                lambda x: np.bincount(x).argmax(),
                axis=0,
                arr=pred_classes
            )
        elif self.ensemble_method == EnsembleMethod.STACKING and self.meta_model is not None:
            # Stack predictions and use meta-model
            stacked_preds = np.array(predictions).transpose(1, 0, 2)
            return self.meta_model.predict(stacked_preds, verbose=0)
        else:
            # Default to averaging
            return np.mean(predictions, axis=0)
    
    def evaluate(self, X: Array, y: Array) -> Dict[str, float]:
        """Evaluate the ensemble on test data."""
        y_pred = self.predict(X)
        y_true = np.argmax(y, axis=1) if len(y.shape) > 1 and y.shape[1] > 1 else y
        y_pred_classes = np.argmax(y_pred, axis=1) if len(y_pred.shape) > 1 and y_pred.shape[1] > 1 else y_pred
        
        metrics = {
            'accuracy': accuracy_score(y_true, y_pred_classes),
            'precision': precision_score(y_true, y_pred_classes, average='weighted', zero_division=0),
            'recall': recall_score(y_true, y_pred_classes, average='weighted', zero_division=0),
            'f1': f1_score(y_true, y_pred_classes, average='weighted', zero_division=0)
        }
        
        # Log metrics
        logger.info("Ensemble Evaluation Metrics:")
        for name, value in metrics.items():
            logger.info(f"{name.capitalize()}: {value:.4f}")
        
        return metrics
    
    def save(self, path: Optional[Union[str, Path]] = None) -> None:
        """Save the entire ensemble."""
        if path is None:
            path = self.output_dir / f"{self.name}.ensemble"
        
        path = Path(path)
        path.mkdir(parents=True, exist_ok=True)
        
        # Save ensemble configuration
        config = {
            'name': self.name,
            'ensemble_method': self.ensemble_method.name,
            'model_configs': [
                {
                    'model_type': m['config'].model_type.name,
                    'params': m['config'].params,
                    'input_shape': m['config'].input_shape,
                    'num_classes': m['config'].num_classes,
                    'name': m['config'].name,
                    'trainable': m['config'].trainable,
                    'weight': m['config'].weight
                }
                for m in self.models
            ]
        }
        
        with open(path / 'config.json', 'w') as f:
            json.dump(config, f, indent=2)
        
        # Save models
        for i, model_info in enumerate(self.models):
            model_dir = path / f"model_{i}"
            model_dir.mkdir(exist_ok=True)
            model_info['model'].save(model_dir / 'model.h5')
        
        # Save meta-model if exists
        if self.meta_model is not None:
            meta_dir = path / 'meta_model'
            meta_dir.mkdir(exist_ok=True)
            self.meta_model.save(meta_dir / 'model.h5')
        
        logger.info(f"Saved ensemble to {path}")
    
    @classmethod
    def load(cls, path: Union[str, Path]) -> 'MicroEnsemble':
        """Load a saved ensemble."""
        path = Path(path)
        
        # Load configuration
        with open(path / 'config.json', 'r') as f:
            config = json.load(f)
        
        # Create model configs
        model_configs = []
        for i, model_cfg in enumerate(config['model_configs']):
            model_config = ModelConfig(
                model_type=ModelType[model_cfg['model_type']],
                params=model_cfg['params'],
                input_shape=tuple(model_cfg['input_shape']),
                num_classes=model_cfg['num_classes'],
                name=model_cfg.get('name'),
                trainable=model_cfg.get('trainable', True),
                weight=model_cfg.get('weight', 1.0)
            )
            model_configs.append(model_config)
        
        # Create ensemble
        ensemble = cls(
            model_configs=model_configs,
            ensemble_method=EnsembleMethod[config['ensemble_method']],
            output_dir=path.parent,
            name=config.get('name', 'micro_ensemble')
        )
        
        # Build and load models
        ensemble.build_models()
        
        # Load model weights
        for i, model_info in enumerate(ensemble.models):
            model_path = path / f"model_{i}" / 'model.h5'
            if model_path.exists():
                model_info['model'] = models.load_model(model_path, compile=False)
        
        # Load meta-model if exists
        meta_model_path = path / 'meta_model' / 'model.h5'
        if meta_model_path.exists():
            ensemble.meta_model = models.load_model(meta_model_path, compile=False)
        
        logger.info(f"Loaded ensemble from {path}")
        return ensemble
    
    def export_to_onnx(self, output_path: Optional[Union[str, Path]] = None) -> None:
        """Export the ensemble to ONNX format."""
        if output_path is None:
            output_path = self.output_dir / f"{self.name}.onnx"
        
        # For simplicity, export each model separately
        for i, model_info in enumerate(self.models):
            model_path = self.output_dir / f"model_{i}.onnx"
            self._export_single_model_to_onnx(model_info['model'], model_path)
        
        logger.info(f"Exported models to ONNX format in {self.output_dir}")
    
    def _export_single_model_to_onnx(self, model: Model, output_path: Union[str, Path]) -> None:
        """Export a single model to ONNX format."""
        model_proto, _ = tf2onnx.convert.from_keras(
            model,
            output_path=str(output_path),
            opset=13
        )
        onnx.save(model_proto, str(output_path))
    
    def optimize_hyperparameters(
        self,
        X: Array,
        y: Array,
        n_trials: int = 50,
        direction: str = 'maximize',
