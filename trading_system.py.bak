logger = logging.getLogger(__name__)
class TradingSystem:
    # ... existing code ...
    
    async def execute_strategy(self, strategy_config: Dict) -> Dict:
        """
        Execute a trading strategy with advanced order types.
        
        Args:
            strategy_config: Dictionary containing strategy configuration:
                - name: Strategy name
                - symbol: Trading symbol
                - quantity: Total quantity
                - order_type: Type of order (MARKET, LIMIT, TWAP, VWAP)
                - duration: Duration for TWAP (seconds)
                - slices: Number of slices for TWAP
                
        Returns:
            Dict: Execution results
        """
        order = Order(
            symbol=strategy_config['symbol'],
            quantity=strategy_config['quantity'],
            order_type=OrderType(strategy_config.get('order_type', 'MARKET')),
            side=strategy_config.get('side', 'buy')
        )
        
        if strategy_config['order_type'].upper() == 'TWAP':
            return await self.order_router.execute_twap(
                order,
                duration=strategy_config.get('duration', 300),
                slices=strategy_config.get('slices', 10)
            )
        elif strategy_config['order_type'].upper() == 'VWAP':
            market_data = await self._get_market_data(order.symbol)
            return await self.order_router.execute_vwap(order, market_data)
        else:
            return await self.order_router.route_order(order)

class TradingSystem:
    def __init__(self, config: Optional[Dict] = None):
        self.config = config or {}
        self.risk_manager = AdvancedRiskManager(
            initial_capital=self.config.get('initial_capital', 1_000_000.0)
        )
        self.order_router = SmartOrderRouter(
            exchanges=self.config.get('exchanges', []),
            config=self.config.get('routing', {})
        )
        self.monitor = AdvancedMonitor(
            config=self.config.get('monitoring', {})
        )
        self.running = False
        self._state_file = self.config.get('state_file', 'trading_system_state.json')
        
    @property
    def portfolio_value(self) -> float:
        """Get current portfolio value"""
        # This is a simplified implementation - should be calculated based on positions
        return self.risk_manager.initial_capital  # Should be enhanced
    
    @property
    def cash_balance(self) -> float:
        """Get current cash balance"""
        # This is a simplified implementation
        return self.risk_manager.initial_capital  # Should track actual cash
    
    @property
    def positions(self) -> Dict[str, float]:
        """Get current positions"""
        return {
            symbol: pos['quantity'] 
            for symbol, pos in self.risk_manager.positions.items()
        }
        
    async def initialize(self) -> None:
        """Initialize all components"""
        if self.running:
            return
            
        try:
            await self._load_state()
            self.running = True
            logger.info("Trading system initialized")
            
        except Exception as e:
            logger.error(f"Initialization failed: {str(e)}")
            await self.shutdown()
            raise
    
    def _create_order_object(self, order_data: Dict) -> Optional[Order]:
        """Create an Order object from order data"""
        try:
            return Order(
                symbol=order_data['symbol'],
                quantity=order_data['quantity'],
                order_type=OrderType(order_data.get('order_type', 'market')),
                side=order_data.get('side', 'buy'),
                price=order_data.get('price'),
                stop_price=order_data.get('stop_price'),
                time_in_force=order_data.get('time_in_force', 'GTC'),
                strategy_id=order_data.get('strategy_id')
            )
        except (KeyError, ValueError) as e:
            logger.error(f"Invalid order data: {str(e)}")
            return None
    
    def _create_error_response(self, message: str) -> Dict:
        """Create a standardized error response"""
        return {
            'status': 'error',
            'message': message,
            'timestamp': time.time()
        }
    
    async def submit_order(self, order_data: Dict) -> Dict:
        """Submit a new order with full risk checks"""
        try:
            # 1. Validate order
            order = self._create_order_object(order_data)
            if not order:
                return self._create_error_response("Invalid order parameters")
                
            # 2. Run pre-trade risk checks
            risk_check = await self._run_risk_checks(order)
            if not risk_check['approved']:
                return self._create_error_response(
                    f"Risk check failed: {risk_check['reason']}"
                )
                
            # 3. Route and execute order
            execution = await self.order_router.route_order(order)
            if execution['status'] != 'executed':
                return self._create_error_response(
                    f"Order execution failed: {execution.get('error', 'Unknown error')}"
                )
                
            # 4. Update risk and monitoring
            await self._update_system_state(order, execution)
            
            return {
                'status': 'success',
                'order_id': execution.get('order_id'),
                'execution_details': execution
            }
            
        except Exception as e:
            error_msg = f"Order submission error: {str(e)}"
            logger.error(error_msg, exc_info=True)
            self.monitor.trigger_alert(
                AlertLevel.CRITICAL,
                "Order Processing Error",
                {'error': str(e), 'order': order_data}
            )
            return self._create_error_response(error_msg)
    
    async def _run_risk_checks(self, order: Order) -> Dict:
        """Run all risk checks for an order"""
        try:
            # 1. Basic validation
            if not self._validate_order(order):
                return {'approved': False, 'reason': 'Invalid order parameters'}
                
            # 2. Position limits
            position_risk = await self.risk_manager._calculate_position_risk(
                {'quantity': order.quantity, 'avg_price': order.price or 0},
                await self._get_market_data(order.symbol)
            )
            if position_risk > self.risk_manager.circuit_breakers['max_position_risk']:
                return {
                    'approved': False,
                    'reason': f'Position risk {position_risk:.1%} exceeds limit'
                }
            
            # 3. Circuit breakers
            triggered = await self.risk_manager.check_circuit_breakers(
                self.portfolio_value,
                await self._get_market_data(order.symbol)
            )
            if triggered:
                return {
                    'approved': False,
                    'reason': f'Circuit breakers triggered: {", ".join(triggered)}'
                }
                
            return {'approved': True}
        except Exception as e:
            logger.error(f"Risk check error: {str(e)}")
            return {'approved': False, 'reason': f'Risk check error: {str(e)}'}
    
    def _validate_order(self, order: Order) -> bool:
        """Validate order parameters"""
        if not order or not order.symbol or order.quantity <= 0:
            return False
        if order.order_type in [OrderType.LIMIT, OrderType.STOP_LIMIT] and order.price is None:
            return False
        if order.order_type in [OrderType.STOP, OrderType.STOP_LIMIT] and order.stop_price is None:
            return False
        return True
    
    async def _get_market_data(self, symbol: str) -> Dict:
        """Get current market data for a symbol"""
        # This should be implemented to fetch real market data
        return {
            'symbol': symbol,
            'price': 100.0,  # Placeholder
            'volume': 1000,  # Placeholder
            'average_volume': 5000  # Placeholder
        }
    
    async def _get_historical_returns(self) -> pd.Series:
        """Get historical returns for VaR calculation"""
        # This should be implemented to fetch real historical data
        import numpy as np
        return pd.Series(np.random.normal(0.001, 0.02, 1000))  # Placeholder
    
    async def _update_system_state(self, order: Order, execution: Dict) -> None:
        """Update system state after order execution"""
        try:
            # Update risk manager
            await self.risk_manager.update_position(
                symbol=order.symbol,
                quantity=order.quantity if order.side == 'buy' else -order.quantity,
                price=execution.get('price', 0),
                timestamp=time.time()
            )
            
            # Record trade in monitor
            self.monitor.record_trade({
                'symbol': order.symbol,
                'quantity': order.quantity,
                'price': execution.get('price'),
                'side': order.side,
                'order_type': order.order_type.value,
                'execution_time': execution.get('timestamp', time.time()),
                'exchange': execution.get('exchange'),
                'commission': execution.get('commission', 0),
                'slippage': execution.get('slippage', 0),
                'pnl': execution.get('pnl', 0)
            })
            
            # Record latency if available
            if 'latency_ms' in execution:
                self.monitor.record_latency(
                    event_type='order_execution',
                    latency_ms=execution['latency_ms']
                )
        except Exception as e:
            logger.error(f"Error updating system state: {str(e)}")
            raise
    
    async def _load_state(self) -> None:
        """Load system state from persistent storage"""
        # Implementation depends on storage backend
        pass
    
    async def _save_state(self) -> None:
        """Save system state to persistent storage"""
        # Implementation depends on storage backend
        pass
    
    async def run_stress_tests(self, scenarios: List[Dict]) -> Dict:
        """Run stress tests on current portfolio"""
        if not self.running:
            return {'status': 'error', 'message': 'System not running'}
            
        try:
            results = await self.risk_manager.run_stress_tests(scenarios)
            return {
                'status': 'success',
                'results': results,
                'timestamp': time.time()
            }
        except Exception as e:
            error_msg = f"Stress test failed: {str(e)}"
            logger.error(error_msg, exc_info=True)
            return {'status': 'error', 'message': error_msg}
    
    async def get_performance_metrics(self) -> Dict:
        """Get current performance metrics"""
        try:
            returns = await self._get_historical_returns()
            return {
                'timestamp': time.time(),
                'portfolio': {
                    'value': self.portfolio_value,
                    'cash': self.cash_balance,
                    'positions': self.positions,
                    'performance': getattr(self.monitor, 'performance_metrics', {})
                },
                'risk': {
                    'var_95': await self.risk_manager.calculate_var(
                        returns,
                        confidence_level=0.95
                    ),
                    'var_99': await self.risk_manager.calculate_var(
                        returns,
                        confidence_level=0.99
                    ),
                    'max_drawdown': getattr(
                        self.monitor.performance_metrics, 
                        'max_drawdown', 
                        0
                    )
                }
            }
        except Exception as e:
            logger.error(f"Error getting performance metrics: {str(e)}")
            return {
                'status': 'error',
                'message': f"Failed to get performance metrics: {str(e)}"
            }
    
    async def shutdown(self) -> None:
        """Shut down the trading system"""
        if not self.running:
            return
            
        try:
            # Save state
            await self._save_state()
            
            # Close connections
            if hasattr(self.order_router, 'close'):
                await self.order_router.close()
            
            self.running = False
            logger.info("Trading system shutdown complete")
            
        except Exception as e:
            logger.error(f"Error during shutdown: {str(e)}")
            raise

