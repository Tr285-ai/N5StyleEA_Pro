{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "__requires": [
    {"type":"panel","id":"timeseries","name":"Time series"},
    {"type":"datasource","id":"prometheus","name":"Prometheus"}
  ],
  "title": "Trading SLOs",
  "uid": "trading-slos",
  "schemaVersion": 37,
  "version": 1,
  "panels": [
    {
      "type":"timeseries",
      "title":"Order success rate % (5m)",
      "datasource":"${DS_PROMETHEUS}",
      "targets":[
        {
          "refId":"A",
          "expr":"100 * ( sum(rate(n5_counter_orders_filled_total[5m])) / clamp_min(sum(rate(n5_counter_orders_received_total[5m])), 1e-9) )",
          "legendFormat":"success_pct"
        }
      ],
      "fieldConfig":{
        "defaults":{
          "thresholds":{
            "mode":"absolute",
            "steps":[{"color":"red","value":0},{"color":"orange","value":99.0},{"color":"green","value":99.5}]
          },
          "unit":"percent"
        },
        "overrides":[]
      },
      "gridPos":{"h":8,"w":12,"x":0,"y":0}
    },
    {
      "type":"timeseries",
      "title":"Error budget burn (1 - success)",
      "datasource":"${DS_PROMETHEUS}",
      "targets":[
        {
          "refId":"A",
          "expr":"1 - ( sum(rate(n5_counter_orders_filled_total[5m])) / clamp_min(sum(rate(n5_counter_orders_received_total[5m])), 1e-9) )",
          "legendFormat":"burn"
        }
      ],
      "fieldConfig":{
        "defaults":{
          "unit":"percentunit",
          "thresholds":{"mode":"absolute","steps":[{"color":"green","value":0},{"color":"orange","value":0.01},{"color":"red","value":0.02}]}
        },
        "overrides":[]
      },
      "gridPos":{"h":8,"w":12,"x":12,"y":0}
    }
  ]
}