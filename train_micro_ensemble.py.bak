def load_sample_data(
    sequence_length: int = 60,
    num_features: int = 10,
    num_samples: int = 10000,
    num_classes: int = 3,
    test_size: float = 0.2,
    random_state: int = 42
) -> Tuple[Tuple[Array, Array], Tuple[Array, Array]]:
    """
    Load or generate sample data for testing.
    
    Args:
        sequence_length: Length of each sequence
        num_features: Number of features per time step
        num_samples: Total number of samples
        num_classes: Number of output classes
        test_size: Fraction of data to use for testing
        random_state: Random seed for reproducibility
        
    Returns:
        Tuple of (X_train, y_train), (X_test, y_test)
    """
    np.random.seed(random_state)
    
    # Generate random sequences
    X = np.random.randn(num_samples, sequence_length, num_features).astype(np.float32)
    
    # Create simple patterns for classification
    y = np.zeros((num_samples,), dtype=np.int32)
    for i in range(num_samples):
        # Simple pattern: if the first feature is increasing, class 1, else class 0
        if X[i, -1, 0] > X[i, 0, 0] + 0.5:
            y[i] = 1
        elif X[i, -1, 0] < X[i, 0, 0] - 0.5:
            y[i] = 2
    
    # Convert to one-hot encoding
    y = tf.keras.utils.to_categorical(y, num_classes=num_classes)
    
    # Split into train and test sets
    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=test_size, random_state=random_state
    )
    
    return (X_train, y_train), (X_test, y_test)

